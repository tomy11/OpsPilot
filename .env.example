# Copy to .env and adjust. Never commit real secrets.
APP_ENV=dev
JWT_SECRET=change-me-dev-only

DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot
ERP_BASE_URL=http://localhost:8100
KNOWLEDGE_BASE_URL=http://localhost:8200

# "temporal" = durable approval workflow, "inline" = run on approval in-process (tests/local)
APPROVAL_BACKEND=temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=opspilot-approvals

# "anthropic" = real Claude, "fake" = deterministic rule-based planner (offline demo/tests)
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Knowledge base: "hash" = offline embeddings, "voyage" = Voyage AI embeddings API
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=voyage-3.5
VOYAGE_API_KEY=
KNOWLEDGE_TOP_K=5
KNOWLEDGE_SEED_ON_STARTUP=true

# DocFlow: clean documents at or below this total (THB) post without a reviewer; 0 = always review
AUTO_POST_LIMIT=5000
MAX_UPLOAD_MB=10

# Mock ERP chaos knobs (0.0 - 1.0, milliseconds)
CHAOS_ERROR_RATE=0.0
CHAOS_LATENCY_MS=0

# Optional Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
