{$STAGING_SITE} {
	encode gzip
	header {
		Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Cache-Control "no-store"
	}

	@workspace path / /assets/* /session/login /session/me /session/redeem /session/refresh /session/logout /agent/runs /agent/conversations /agent/conversations/* /approvals /approvals/* /internal/approvals/* /audit /ready
	handle @workspace {
		reverse_proxy agent:8000
	}
	@knowledgeAsk {
		method POST
		path /knowledge/ask
	}
	handle @knowledgeAsk {
		reverse_proxy knowledge:8200
	}
	handle {
		respond 404
	}
}
